# Python runtime
CRYPTO_AGENT_ENV=development
MEMORY_DB_PATH=data/crypto_agent.db
CRYPTO_AGENT_SOCK=/tmp/crypto-agent-py.sock

# Docker user mapping. Fill these with `id -u` and `id -g` for local deploys.
CRYPTO_AGENT_UID=1000
CRYPTO_AGENT_GID=1000

# Future live-exchange configuration. The current Python daemon does not place
# live orders by default; live OKX trading must pass a separate readiness gate.
DEFAULT_EXCHANGE=okx
PAPER_TRADING=true
EXCHANGE_API_KEY=
EXCHANGE_SECRET=
EXCHANGE_PASSWORD=
CONTRACT_MARGIN_MODE=isolated

# Default paper identity is created by crypto_agent/db/schema.py:
# funding-default -> trading-paper-default -> bot-default -> allocation-default.
