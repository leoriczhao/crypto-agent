FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

COPY pyproject.toml ./
COPY crypto_agent ./crypto_agent
COPY agents ./agents

RUN pip install --no-cache-dir .

CMD ["crypto-agent-py", "daemon", "--database-path", "/data/crypto_agent.db", "--socket-path", "/run/crypto-agent/crypto-agent.sock", "--init-db"]
